<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);1998</NoWarn>
    <Version>1.0.0</Version>
    <IkonApp>true</IkonApp>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup>
    <IkonRoot>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'ikon-platform.slnx'))</IkonRoot>
    <IsIkonInternal Condition="'$(IkonRoot)' != ''">true</IsIkonInternal>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsIkonInternal)' != 'true'">
    <PackageReference Include="Ikon.AI" Version="3.2.27" />
    <PackageReference Include="Ikon.AI.Emergence" Version="3.2.27" />
    <PackageReference Include="Ikon.App" Version="3.2.27" />
    <PackageReference Include="Ikon.Common" Version="3.2.27" />
    <PackageReference Include="Ikon.Common.Core" Version="3.2.27" />
    <PackageReference Include="Ikon.Crosswind" Version="3.2.27" />
    <PackageReference Include="Ikon.Parallax" Version="3.2.27" />
    <PackageReference Include="Ikon.Pipeline" Version="3.2.27" />
    <PackageReference Include="Ikon.Pipelines.Public" Version="3.2.27" />
    <PackageReference Include="Ikon.Resonance" Version="3.2.27" />
    <PackageReference Include="Ikon.Resonance.Core" Version="3.2.27" />
    <PackageReference Include="Ikon.Server" Version="3.2.27" />
    <PackageReference Include="Ikon.Teleport" Version="3.2.27" />
    <PackageReference Include="Ikon.Sdk" Version="2.0.14.277" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsIkonInternal)' == 'true'">
    <ProjectReference Include="$(IkonRoot)\Ikon.AI\Ikon.AI.csproj" />
    <ProjectReference Include="$(IkonRoot)\Ikon.AI.Emergence\Ikon.AI.Emergence.csproj" />
    <ProjectReference Include="$(IkonRoot)\Ikon.App\Ikon.App.csproj" />
    <ProjectReference Include="$(IkonRoot)\Ikon.Common\Ikon.Common.csproj" />
    <ProjectReference Include="$(IkonRoot)\Ikon.Common.Core\Ikon.Common.Core.csproj" />
    <ProjectReference Include="$(IkonRoot)\Ikon.Crosswind\Ikon.Crosswind.csproj" />
    <ProjectReference Include="$(IkonRoot)\Ikon.Parallax\Ikon.Parallax.csproj" />
    <ProjectReference Include="$(IkonRoot)\Ikon.Pipeline\Ikon.Pipeline.csproj" />
    <ProjectReference Include="$(IkonRoot)\Ikon.Pipelines.Public\Ikon.Pipelines.Public.csproj" />
    <ProjectReference Include="$(IkonRoot)\Ikon.Resonance\Ikon.Resonance.csproj" />
    <ProjectReference Include="$(IkonRoot)\Ikon.Resonance.Core\Ikon.Resonance.Core.csproj" />
    <ProjectReference Include="$(IkonRoot)\Ikon.Server\Ikon.Server.csproj" />
    <ProjectReference Include="$(IkonRoot)\Ikon.Teleport\Ikon.Teleport.csproj" />
    <ProjectReference Include="$(IkonRoot)\Ikon.Sdk\Ikon.Sdk.csproj" />
  </ItemGroup>
  <Target Name="IkonAppTeleportBuildInternal" BeforeTargets="BeforeBuild" Condition="'$(IsIkonInternal)' == 'true' And Exists('$(MSBuildProjectDirectory)/../../schema')">
    <MSBuild Projects="$(IkonRoot)/BuildUtil/BuildUtil.csproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="OutDir;OutputPath;PublishDir;BaseOutputPath;IntermediateOutputPath;BaseIntermediateOutputPath">
      <Output TaskParameter="TargetOutputs" ItemName="_BuildUtilOutput" />
    </MSBuild>
    <Exec Command="dotnet &quot;@(_BuildUtilOutput)&quot; --generate-app-teleport --app-dir &quot;$(MSBuildProjectDirectory)/../..&quot;" />
    <ItemGroup>
      <Compile Include="$(MSBuildProjectDirectory)/Generated/**/*.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>
  <Target Name="IkonAppTeleportBuildExternal" BeforeTargets="BeforeBuild" Condition="'$(IsIkonInternal)' != 'true' And Exists('$(MSBuildProjectDirectory)/../../schema')">
    <Exec Command="ikon app teleport build --target-dir &quot;$(MSBuildProjectDirectory)/../..&quot;" EnvironmentVariables="CI=true" ContinueOnError="WarnAndContinue" />
    <ItemGroup>
      <Compile Include="$(MSBuildProjectDirectory)/Generated/**/*.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../ikon-config*.toml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="Data\**\*" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
